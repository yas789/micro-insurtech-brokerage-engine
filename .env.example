# PHP Gateway
BROKER_CORE_API_BASE_URL=http://localhost:5000
BROKER_CORE_API_TIMEOUT_SECONDS=15
APP_ENV=local

# .NET Core Engine
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__BrokerDatabase=Server=localhost,1433;Database=MicroInsurTech;User Id=sa;Password=change-me;TrustServerCertificate=True;
POSTCODES_API_BASE_URL=https://postcodes.io

# Local SQL Server Docker helpers
SQLSERVER_CONTAINER_NAME=micro-insurtech-sql
SQLSERVER_DATABASE_NAME=MicroInsurTech
SQLSERVER_HOST_PORT=1433
SQLSERVER_SA_PASSWORD=change-me
CORE_ENGINE_BASE_URL=http://localhost:5000

# Local frontend proxy (browser -> PHP gateway)
FRONTEND_PORT=3000
GATEWAY_PORT=8080
GATEWAY_BASE_URL=http://127.0.0.1:8080
FRONTEND_BASE_URL=http://127.0.0.1:3000
